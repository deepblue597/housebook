              }
            ],
            "title": "Support"
          },
          "critical": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Critical"
          },
          "attachments": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Attachments"
          }
        },
        "type": "object",
        "title": "ItemFieldsOut",
        "description": "Typed frontmatter. Invalid values are null here and listed in /api/problems."
