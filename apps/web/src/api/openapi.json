      "ItemType": {
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,39}$",
            "title": "Key"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "defaultName": {
            "type": "string",
            "title": "Defaultname"
          },
          "footprint": {
            "prefixItems": [
              {
                "type": "integer",
                "maximum": 512.0,
                "minimum": 1.0
              },
              {
                "type": "integer",
                "maximum": 512.0,
                "minimum": 1.0
              }
            ],
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "title": "Footprint",
            "default": [
              1,
              1
            ]
          },
          "mount": {
            "type": "string",
            "enum": [
              "floor",
              "wall",
              "ceiling"
