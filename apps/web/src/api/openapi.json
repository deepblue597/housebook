{
  "openapi": "3.1.0",
  "info": {
    "title": "Housebook",
    "version": "0.1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Healthz",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "summary": "Readyz",
        "description": "Ready = first scan done and the data root writable (needed from milestone 4 on).",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/house": {
      "get": {
        "summary": "Get House",
        "operationId": "get_house_api_house_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/House"
                }
              }
            }
          },
          "304": {
            "description": "Not Modified"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/snapshot": {
      "get": {
        "summary": "Get Snapshot",
        "description": "House + every item (with body and status) in one response, for first load, the\noffline cache and client-side search. Poll with If-None-Match.",
        "operationId": "get_snapshot_api_snapshot_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SnapshotOut"
                }
              }
            }
          },
          "304": {
            "description": "Not Modified"
          }
        }
      }
    },
    "/api/items": {
      "get": {
        "summary": "List Items",
        "operationId": "list_items_api_items_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ],
              "description": "Search query (DESIGN 15.9)",
              "title": "Q"
            },
            "description": "Search query (DESIGN 15.9)"
          },
          {
            "name": "due",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 3650,
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "description": "Check or warranty due within N days",
              "title": "Due"
            },
            "description": "Check or warranty due within N days"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemListOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/items/{item_id}": {
      "get": {
        "summary": "Get Item",
        "operationId": "get_item_api_items__item_id__get",
        "parameters": [
          {
            "name": "item_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Item Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemDetailOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/items/{item_id}/attachments/{name}": {
      "get": {
        "summary": "Get Attachment",
        "operationId": "get_attachment_api_items__item_id__attachments__name__get",
        "parameters": [
          {
            "name": "item_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Item Id"
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Name"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/problems": {
      "get": {
        "summary": "Get Problems",
        "operationId": "get_problems_api_problems_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemsOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/catalog": {
      "get": {
        "summary": "Get Catalog",
        "operationId": "get_catalog_api_catalog_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Catalog"
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "summary": "Get Me",
        "operationId": "get_me_api_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOut"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AttachmentOut": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "size": {
            "type": "integer",
            "title": "Size"
          },
          "listed": {
            "type": "boolean",
            "title": "Listed",
            "description": "Listed in frontmatter (vs. only found in the sibling folder)"
          },
          "url": {
            "type": "string",
            "title": "Url"
          }
        },
        "type": "object",
        "required": [
          "name",
          "size",
          "listed",
          "url"
        ],
        "title": "AttachmentOut"
      },
      "Catalog": {
        "properties": {
          "version": {
            "type": "integer",
            "title": "Version",
            "default": 1
          },
          "types": {
            "items": {
              "$ref": "#/components/schemas/ItemType"
            },
            "type": "array",
            "title": "Types"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "types"
        ],
        "title": "Catalog"
      },
      "CheckStatus": {
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "overdue",
              "due_soon",
              "scheduled"
            ],
            "title": "State"
          },
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "days": {
            "type": "integer",
            "title": "Days"
          },
          "derived": {
            "type": "boolean",
            "title": "Derived"
          }
        },
        "type": "object",
        "required": [
          "state",
          "date",
          "days",
          "derived"
        ],
        "title": "CheckStatus"
      },
      "Floor": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "level": {
            "type": "integer",
            "maximum": 200.0,
            "minimum": -20.0,
            "title": "Level",
            "default": 0
          },
          "cells": {
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "pattern": "^(0|[1-9][0-9]*),(0|[1-9][0-9]*)$"
            },
            "type": "object",
            "title": "Cells",
            "description": "Map of \"x,y\" -> room id. Keys are non-negative integers without padding."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "Floor"
      },
      "Grid": {
        "properties": {
          "tileSize": {
            "type": "number",
            "maximum": 10.0,
            "exclusiveMinimum": 0.0,
            "title": "Tilesize",
            "description": "Metres per tile",
            "default": 1.0
          },
          "width": {
            "type": "integer",
            "maximum": 512.0,
            "minimum": 1.0,
            "title": "Width",
            "description": "Tiles along x (east)"
          },
          "depth": {
            "type": "integer",
            "maximum": 512.0,
            "minimum": 1.0,
            "title": "Depth",
            "description": "Tiles along y (south)"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "width",
          "depth"
        ],
        "title": "Grid"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthOut": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "checks": {
            "additionalProperties": {
              "type": "boolean"
            },
            "type": "object",
            "title": "Checks"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthOut"
      },
      "House": {
        "properties": {
          "$schema": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "$Schema"
          },
          "schemaVersion": {
            "type": "integer",
            "const": 1,
            "title": "Schemaversion"
          },
          "grid": {
            "$ref": "#/components/schemas/Grid"
          },
          "rooms": {
            "items": {
              "$ref": "#/components/schemas/Room"
            },
            "type": "array",
            "title": "Rooms"
          },
          "floors": {
            "items": {
              "$ref": "#/components/schemas/Floor"
            },
            "type": "array",
            "minItems": 1,
            "title": "Floors"
          },
          "placements": {
            "items": {
              "$ref": "#/components/schemas/Placement"
            },
            "type": "array",
            "title": "Placements"
          },
          "openings": {
            "items": {
              "$ref": "#/components/schemas/Opening"
            },
            "type": "array",
            "title": "Openings"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "schemaVersion",
          "grid",
          "floors"
        ],
        "title": "House"
      },
      "HouseProblemReason": {
        "type": "string",
        "enum": [
          "unreadable",
          "too_large",
          "not_json",
          "bad_version",
          "newer_version",
          "invalid"
        ],
        "title": "HouseProblemReason",
        "description": "Why house.json is unusable: `detail.reason` on every `house_invalid` and\n`house_newer_version` problem. A closed set: clients switch on it, never on `message`."
      },
      "ItemDetailOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "path": {
            "type": "string",
            "title": "Path",
            "description": "Note path relative to the data root"
          },
          "etag": {
            "type": "string",
            "title": "Etag",
            "description": "Content hash of the note file; send as If-Match on writes"
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "`name`, or the file name when missing"
          },
          "type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Type",
            "description": "Canonical catalogue key (aliases resolved), or the raw value if unknown"
          },
          "typeKnown": {
            "type": "boolean",
            "title": "Typeknown"
          },
          "critical": {
            "type": "boolean",
            "title": "Critical",
            "description": "`critical` from frontmatter, else the catalogue default"
          },
          "fields": {
            "$ref": "#/components/schemas/ItemFieldsOut"
          },
          "frontmatter": {
            "additionalProperties": true,
            "type": "object",
            "title": "Frontmatter",
            "description": "All frontmatter keys as read (strings), unknown keys included"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "location": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LocationOut"
              },
              {
                "type": "null"
              }
            ],
            "description": "Placement and derived room; null when unplaced"
          },
          "errorCodes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Errorcodes"
          },
          "attachments": {
            "items": {
              "$ref": "#/components/schemas/AttachmentOut"
            },
            "type": "array",
            "title": "Attachments"
          },
          "stale": {
            "type": "boolean",
            "title": "Stale",
            "description": "The file currently fails to parse; this is the last good version"
          },
          "parseError": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parseerror"
          },
          "obsidianUrl": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Obsidianurl"
          },
          "body": {
            "type": "string",
            "title": "Body"
          }
        },
        "type": "object",
        "required": [
          "id",
          "path",
          "etag",
          "name",
          "type",
          "typeKnown",
          "critical",
          "fields",
          "frontmatter",
          "status",
          "location",
          "errorCodes",
          "attachments",
          "stale",
          "body"
        ],
        "title": "ItemDetailOut"
      },
      "ItemFieldsOut": {
        "properties": {
